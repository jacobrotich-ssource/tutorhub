services:
  db:
    image: postgres:17
    environment:
      POSTGRES_USER: studyhub
      POSTGRES_PASSWORD: studyhub_local_only
      POSTGRES_DB: studyhub
    ports:
      - "127.0.0.1:5433:5432"
    volumes:
      - studyhub_pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U studyhub -d studyhub"]
      interval: 5s
      timeout: 5s
      retries: 10

volumes:
  studyhub_pgdata: